[package]
name = "web-worker-guard"
description = "Confine labeled web workers against shell and network tool execution and web-shell writes."
license = "GPL-2.0 OR BSD-2-Clause"
authors = ["Authors of shirudo"]

[[upatches]]
source = "web-worker-guard.bpf.c"

[[upatches.policy]]
id = "web-worker"
bit = 0x1
paths = ["/usr/sbin/php-fpm*", "/usr/local/sbin/php-fpm", "/usr/sbin/apache2", "/usr/sbin/httpd", "/usr/local/apache2/bin/httpd", "/usr/sbin/nginx", "/usr/local/nginx/sbin/nginx"]

[upatches.tree]
id = "web-worker-guard"
fixes = ["CVE-2026-109618", "CVE-2026-109619"]
